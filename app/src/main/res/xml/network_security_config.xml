<?xml version="1.0" encoding="utf-8"?>
<!--
  Three of the four hosts this app talks to are Polish and chain up to "Certum Trusted
  Root CA", which Android only started shipping fairly recently. An API 33 image carries
  "Certum Trusted Network CA" and "Network CA 2" but not this one (verified by grepping
  /system/etc/security/cacerts on the emulator), so on anything that old the handshake
  dies with "Trust anchor for certification path not found":

    api.gios.gov.pl           air quality, fails silently into an empty card
    km.rybnik.pl              the GTFS feed, so no timetable at all
    www.tauron-dystrybucja.pl power cuts

  Sending the root in the chain, as km.rybnik.pl does, changes nothing: a root the device
  does not trust is ignored. So the root travels with the app, scoped to those hosts.
  Everything else, raw.githubusercontent.com included, keeps using the system store alone
  — it chains to ISRG Root X1, which has been in Android since 7.1.1.

  The bundled copy comes from Mozilla's CA bundle (curl.se/ca/cacert.pem), SHA-256
  FE:76:96:57:38:55:77:3E:37:A9:5E:7A:D4:D9:CC:96:C3:01:57:C1:5D:31:76:5B:A9:B1:57:04:E1:AE:78:FD,
  and it was checked with `openssl verify` against the live chain of each host above.
  It expires in March 2043; by then the system stores will have caught up anyway.
-->
<network-security-config>
    <!--
      minSdk is 26, and Android only started denying cleartext by default in 9 (API 28),
      so on 8.x an http:// URL would have gone out in the clear. Every address in the code
      is https, but the GTFS location is not in the code: it arrives in transit_meta.json,
      so a future feed could point anywhere. Denying cleartext outright means the Data
      Safety answer "encrypted in transit" stays true by construction rather than by
      inspection, and a plain-http feed fails visibly instead of quietly downgrading.
    -->
    <base-config cleartextTrafficPermitted="false" />

    <domain-config>
        <domain includeSubdomains="true">gios.gov.pl</domain>
        <domain includeSubdomains="true">km.rybnik.pl</domain>
        <domain includeSubdomains="true">tauron-dystrybucja.pl</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/certum_trusted_root" />
        </trust-anchors>
    </domain-config>
</network-security-config>
