<!--
  Notification small icon: the fish from the city arms, matching the launcher.

  Android draws this as a mask — every non-transparent pixel becomes solid white (or
  whatever the system tints it), so the shape has to read as a silhouette. The eye is
  therefore a hole punched with evenOdd rather than a lighter fill, which would simply
  disappear.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Body with a pointed snout on the right, plus the eye as a cut-out. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M22.2,12
                          C19.2,15.6 15.6,17.6 11.6,17.6
                          C7.7,17.6 5.1,15.1 4.3,12
                          C5.1,8.9 7.7,6.4 11.6,6.4
                          C15.6,6.4 19.2,8.4 22.2,12 Z
                          M18,9.3
                          C18.6,9.3 19.1,9.8 19.1,10.4
                          C19.1,11 18.6,11.5 18,11.5
                          C17.4,11.5 16.9,11 16.9,10.4
                          C16.9,9.8 17.4,9.3 18,9.3 Z" />

    <!-- Tail: a wedge with a concave trailing edge, so it does not read as an arrow. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4.6,12
                          L1.4,7.4
                          C2.6,9.9 2.6,14.1 1.4,16.6 Z" />

    <!-- Dorsal fin. Small, but it is what stops the body reading as a leaf. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.1,6.7
                          C10.4,4.6 12.1,3.1 14.5,2.9
                          C13.4,4.1 13,5.4 13.2,6.5 Z" />
</vector>
